{
  "name": "dsh-malko-prefs",
  "version": "0.1.0",
  "description": "Personal dsh preferences: a tunable companion to the official compaction engine (threshold, retention, summarization model/reasoning, turn-end compaction) and llama.cpp model-enrichment for the Models page",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": { "default": "./lib/index.mjs" },
    "./compaction": { "default": "./lib/compaction.mjs" },
    "./client": { "default": "./lib/client.js" },
    "./typert": { "default": "./lib/typert.host.mjs" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "scripts/",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Jonathan Gotti aka malko <jgotti@jgotti.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malko/dsh-malko-prefs.git"
  },
  "homepage": "https://github.com/malko/dsh-malko-prefs#readme",
  "bugs": {
    "url": "https://github.com/malko/dsh-malko-prefs/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "compaction",
    "context",
    "llama.cpp",
    "models"
  ],
  "scripts": {
    "build": "node build.mjs",
    "gen-patch": "node scripts/gen-preset-override.mjs",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run build && npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/schemastery": ">=3.18.4",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.7-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-compaction-basic": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "esbuild": "^0.28.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
